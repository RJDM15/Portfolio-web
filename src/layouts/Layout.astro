---
import { data } from "../Data/data";
import "../styles/global.css";
import { Topbar } from "../components/Home/Topbar";
import { Footer } from "../components/Footer/Footer";

const language = Astro.params.language || "es";
const title = data.translations[language] ? data.translations[language].title : data.translations.es.title;
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			const theme = localStorage.getItem("theme");
			if (theme === "light") {
				document.documentElement.classList.remove("dark");
			} else {
				document.documentElement.classList.add("dark");
			}
		</script>
	</head>
	<body>
		<Topbar language={language} client:load />
		<slot />
		<Footer language={language} client:load />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
